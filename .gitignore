# Secrets and developer-specific configuration. Commit only the sanitized template.
.env
.env.*
!.env.example

# Private keys, certificates, and service credentials.
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/
credentials/
service-account*.json
