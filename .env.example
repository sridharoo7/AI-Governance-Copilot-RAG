WEAVIATE_URL=http://weaviate:8080
WEAVIATE_GRPC_URL=weaviate:50051
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
# Leave OmniRoute values blank for local Ollama-first development. Add them later to
# route production traffic through a managed gateway with the direct provider as fallback.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
DIRECT_LLM_BASE_URL=http://host.docker.internal:11434/v1
DIRECT_LLM_API_KEY=ollama
RAG_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=180
RAG_GENERATION_PROVIDER=gemini
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_SUPPORTS_STRUCTURED_OUTPUTS=true
COHERE_API_KEY=
GOOGLE_API_KEY=
RAGAS_JUDGE_PROVIDER=gemini_openai_compatible
RAGAS_JUDGE_MODEL=gemini-3.1-flash-lite
CORPUS_RELEASE_ID=governance-security-expanded-2026-07-23-r1
